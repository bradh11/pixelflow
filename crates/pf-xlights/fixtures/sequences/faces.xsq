<?xml version="1.0" encoding="UTF-8"?>
<!-- Faces effects on the sample show's "Window Matrix" face "Singer": one singing a lyric
     track's phonemes, one on the first face with a track that isn't in the sequence, and one on
     a picture face that wasn't imported. -->
<xsequence BaseChannel="0" ChanCtrlBasic="0" ChanCtrlColor="0" FixedPointTiming="1" ModelBlending="true">
  <head>
    <version>2025.01</version>
    <song>Faces</song>
    <sequenceTiming>25 ms</sequenceTiming>
    <sequenceType>Media</sequenceType>
    <sequenceDuration>10.000</sequenceDuration>
  </head>
  <ColorPalettes>
    <ColorPalette>C_BUTTON_Palette1=#FF0000,C_BUTTON_Palette2=#00FF00,C_BUTTON_Palette3=#0000FF,C_CHECKBOX_Palette1=1,C_CHECKBOX_Palette2=1,C_CHECKBOX_Palette3=1</ColorPalette>
  </ColorPalettes>
  <EffectDB>
    <Effect>E_CHECKBOX_Faces_Outline=1,E_CHOICE_Faces_Eyes=Open,E_CHOICE_Faces_FaceDefinition=Singer,E_CHOICE_Faces_TimingTrack=Lyrics</Effect>
    <Effect>E_CHOICE_Faces_Eyes=Auto,E_CHOICE_Faces_EyeBlinkFrequency=Fast,E_CHOICE_Faces_FaceDefinition=Default,E_CHOICE_Faces_TimingTrack=Chorus</Effect>
    <Effect>E_CHOICE_Faces_FaceDefinition=Pictures,E_CHOICE_Faces_TimingTrack=Lyrics</Effect>
  </EffectDB>
  <ElementEffects>
    <Element type="timing" name="Lyrics">
      <EffectLayer>
        <Effect label="I sing" startTime="1000" endTime="2000"/>
      </EffectLayer>
      <EffectLayer>
        <Effect label="I" startTime="1000" endTime="1400"/>
        <Effect label="sing" startTime="1400" endTime="2000"/>
      </EffectLayer>
      <EffectLayer>
        <Effect label="AI" startTime="1000" endTime="1400"/>
        <Effect label="etc" startTime="1400" endTime="1600"/>
        <Effect label="O" startTime="1600" endTime="2000"/>
      </EffectLayer>
    </Element>
    <Element type="model" name="Window Matrix">
      <EffectLayer>
        <Effect ref="0" name="Faces" palette="0" startTime="0" endTime="4000"/>
        <Effect ref="1" name="Faces" palette="0" startTime="4000" endTime="6000"/>
        <Effect ref="2" name="Faces" palette="0" startTime="6000" endTime="8000"/>
      </EffectLayer>
    </Element>
  </ElementEffects>
</xsequence>
