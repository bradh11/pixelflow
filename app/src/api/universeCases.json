[
  {
    "name": "15-channel universes hold five RGB pixels",
    "runs": [{ "pixels": 12, "cpp": 3 }],
    "size": 15,
    "straddle": false,
    "expect": [[0, 15], [15, 15], [30, 6]]
  },
  {
    "name": "a size that isn't a whole number of pixels ends each universe early",
    "runs": [{ "pixels": 6, "cpp": 3 }],
    "size": 16,
    "straddle": false,
    "expect": [[0, 15], [15, 3]]
  },
  {
    "name": "straddling fills every universe",
    "runs": [{ "pixels": 6, "cpp": 3 }],
    "size": 16,
    "straddle": true,
    "expect": [[0, 16], [16, 2]]
  },
  {
    "name": "RGB then RGBW on 270-channel universes",
    "runs": [{ "pixels": 100, "cpp": 3 }, { "pixels": 10, "cpp": 4 }],
    "size": 270,
    "straddle": false,
    "expect": [[0, 270], [270, 70]]
  },
  {
    "name": "RGBW on 426-channel universes",
    "runs": [{ "pixels": 200, "cpp": 4 }],
    "size": 426,
    "straddle": false,
    "expect": [[0, 424], [424, 376]]
  },
  {
    "name": "a universe smaller than a pixel runs channels straight through",
    "runs": [{ "pixels": 1, "cpp": 1 }, { "pixels": 2, "cpp": 3 }],
    "size": 2,
    "straddle": false,
    "expect": [[0, 2], [2, 2], [4, 2], [6, 1]]
  },
  {
    "name": "one-channel universes",
    "runs": [{ "pixels": 1, "cpp": 4 }, { "pixels": 1, "cpp": 3 }],
    "size": 1,
    "straddle": false,
    "expect": [[0, 1], [1, 1], [2, 1], [3, 1], [4, 1], [5, 1], [6, 1]]
  },
  {
    "name": "512-channel universes without straddling",
    "runs": [{ "pixels": 200, "cpp": 3 }],
    "size": 512,
    "straddle": false,
    "expect": [[0, 510], [510, 90]]
  },
  {
    "name": "no pixels, no universes",
    "runs": [],
    "size": 37,
    "straddle": false,
    "expect": []
  }
]
